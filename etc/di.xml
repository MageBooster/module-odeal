<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="OdealFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">MageBooster\Odeal\Model\Settings::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">MageBooster\Odeal\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">OdealValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">OdealValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">OdealCommandPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="OdealConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">MageBooster\Odeal\Model\Settings::CODE</argument>
        </arguments>
    </virtualType>
    <virtualType name="OdealValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">OdealConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="OdealConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">OdealConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="OdealCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">OdealConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="OdealValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">OdealCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="OdealCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">MageBooster\Odeal\Gateway\Command\InitializeCommand</item>
                <item name="refund" xsi:type="string">MageBooster\Odeal\Gateway\Command\RefundCommand</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="MageBooster\Odeal\Block\Info">
        <arguments>
            <argument name="config" xsi:type="object">OdealConfig</argument>
        </arguments>
    </type>
    <type name="MageBooster\Odeal\Model\Settings">
        <arguments>
            <argument name="config" xsi:type="object">OdealConfig</argument>
        </arguments>
    </type>
    <virtualType name="OdealLogHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/magebooster_mbodeal.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="OdealMonolog" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">magebooster_mbodeal</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">OdealLogHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="MageBooster\Odeal\Model\DebugLog">
        <arguments>
            <argument name="logger" xsi:type="object">OdealMonolog</argument>
        </arguments>
    </type>
    <type name="MageBooster\License\Model\Products">
        <arguments>
            <argument name="products" xsi:type="array">
                <item name="odeal" xsi:type="array">
                    <item name="label" xsi:type="string">Odeal payments</item>
                    <item name="codes" xsi:type="array">
                        <item name="odeal" xsi:type="string">odeal</item>
                        <item name="odeal-hyva" xsi:type="string">odeal-hyva</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
